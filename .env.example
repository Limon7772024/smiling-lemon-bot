# ⚙️ ФАЙЛ НАСТРОЕК SMILING-LEMON v6.3 (`.env`)
# Скопируйте этот файл в папку shpora-network и назовите его ровно: .env
# Заполните только 3 строки: BOT_TOKEN, LLM_API_KEY, ADMIN_IDS.
# Всё остальное можно не трогать — значения по умолчанию уже настроены под v6.3!

# ============ 1. ОБЯЗАТЕЛЬНО: ТОКЕН БОТА ============
# Где взять: Telegram -> @BotFather -> /mybots -> @ShporaNMT_bot -> API Token
BOT_TOKEN=

# ============ 2. ОБЯЗАТЕЛЬНО: КЛЮЧ БЕСПЛАТНОГО ИИ GEMINI ============
# Бесплатно без карты: https://aistudio.google.com/apikey (ключ начинается на AIza...)
LLM_API_KEY=
# Дополнительные бесплатные ключи Gemini для ускорения и защиты от лимитов (по желанию):
# Формат: LLM_API_KEYS=["AIza...ключ2","AIza...ключ3"]
LLM_API_KEYS=[]
LLM_BASE_URL=https://api.openai.com/v1
LLM_FREE_MODEL=gpt-4o-mini
LLM_PRO_MODEL=gpt-4o
LLM_REASONING_EFFORT=128

# ============ 3. ОБЯЗАТЕЛЬНО: ВАШ ЧИСЛОВОЙ ID (БЕЗЛИМИТ ВЛАДЕЛЬЦА) ============
# Узнать в боте командой /myid и вписать в квадратных скобках:
ADMIN_IDS=[123456789]

# ============ 4. ЯЗЫК И НОМЕР БОТА В СЕТИ ============
# Номер бота (1 = @ShporaNMT_bot, 2 = второй бот-сателлит, 3 = третий бот-сателлит)
BOT_ID=1
# true = бот понимает запрос на любом языке, но всегда отвечает на чисто украинском (режим UA)
# false = мультиязычный режим (uk / ru / be / en) — оставлено готовым на будущее!
LANG_UKRAINIAN_ONLY=true
BOT_REGION=UA
EXTRA_BOT_TOKENS=[]

# ============ 5. БАЗА ДАННЫХ (SQLite для ПК и VPS за $4/мес) ============
DATABASE_URL=sqlite+aiosqlite:///./shpora.db
USE_TASKIQ_QUEUE=false
REDIS_URL=redis://redis:6379/0
WEBHOOK_BASE_URL=https://api.yourdomain.com

# ============ 6. ПЛАТЕЖИ (выключено на старте, включается позже /toggle_pro) ============
STARS_PRICE_PRO=500
MONO_MERCHANT_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
BEPAID_SHOP_ID=
BEPAID_SECRET_KEY=
